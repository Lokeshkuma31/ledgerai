# AI Financial Coach — provider configuration
# Copy to .env.local and fill in the key for whichever provider you select.
# AI_PROVIDER selects the active backend: anthropic | openai | gemini | openrouter | ollama
AI_PROVIDER=openrouter

# Anthropic (default)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4.8

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5

# Ollama (local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
