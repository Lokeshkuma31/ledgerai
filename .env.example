# AI Financial Coach — provider configuration
# Copy to .env.local and fill in the key for whichever provider you select.
# AI_PROVIDER selects the active backend: anthropic | openai | gemini | openrouter | ollama
AI_PROVIDER=openrouter

# Anthropic (default)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4.8

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Ollama (local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Connection Hub — OAuth 2.0 credentials for Gmail, Outlook, and Yahoo.
# Tokens are encrypted at rest with this key; generate one with:
#   openssl rand -base64 32
CONNECTION_HUB_ENCRYPTION_KEY=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Add {origin}/api/connections/google/callback as an
# authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Azure Portal -> App registrations -> your app -> Certificates & secrets.
# Add {origin}/api/connections/microsoft/callback as a redirect URI
# (platform: Web).
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Yahoo Developer Network -> My Apps -> your app -> API Permissions.
# Add {origin}/api/connections/yahoo/callback as a redirect URI.
YAHOO_OAUTH_CLIENT_ID=
YAHOO_OAUTH_CLIENT_SECRET=

# --- Production backend infrastructure (see plan: production backend architecture) ---

# Postgres (Neon) — provisioned via `vercel integration add neon`, auto-synced
# to .env.local by `vercel env pull`. DIRECT_DATABASE_URL is the unpooled
# connection Prisma Migrate needs (migrations don't work through a pgbouncer
# pool); DATABASE_URL is the pooled connection the app uses at runtime.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Upstash Redis — provisioned via `vercel integration add upstash/upstash-kv`.
# The app's cache/rate-limit/lock layer reads these (Vercel's Upstash
# integration names them KV_REST_API_URL / KV_REST_API_TOKEN).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Inngest — provisioned via `vercel integration add inngest/account`.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Cloudflare R2 — NOT on the Vercel marketplace; create manually in the
# Cloudflare dashboard (R2 Object Storage -> create bucket, then
# R2 -> Manage API tokens -> Object Read & Write scoped to that bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Better Auth — user identity/login (distinct from the Connection Hub OAuth
# above, which is for connecting Gmail/Outlook/Yahoo as data sources, not
# for signing in). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Better Auth's own Google sign-in client — intentionally a SEPARATE OAuth
# app from GOOGLE_OAUTH_CLIENT_ID above (identity vs. data-source connection).
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=

# --- Observability (see docs/observability/) ---

# Structured logging (lib/observability/logger.ts). Defaults to "info" in
# production, "debug" elsewhere.
LOG_LEVEL=

# OpenTelemetry tracing (lib/observability/tracing.ts). Unset in dev/preview
# uses a console exporter; set to an OTLP HTTP collector endpoint in
# production. OTEL_TRACE_SAMPLE_RATE only applies in production (dev/preview
# always sample 100%) — errors/jobs/OAuth/Server Action spans are always
# sampled regardless of this value.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATE=0.2

# Sentry error tracking (lib/observability/errors.ts). Enabled by default
# when VERCEL_ENV is production/preview; set SENTRY_ENABLED=true to force it
# on elsewhere (e.g. to smoke-test locally).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENABLED=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog product analytics (lib/observability/analytics.ts). No-ops
# cleanly when unset.
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=

# Feature flags (lib/flags.ts). Provider sync (Gmail/Outlook/Yahoo/OCR/
# Account Aggregator) currently returns mock data behind real OAuth — see
# docs/provider-integration/README.md. Set to "false" as an emergency kill
# switch; any other value (or unset) leaves sync enabled.
NEXT_PUBLIC_PROVIDER_SYNC_ENABLED=
