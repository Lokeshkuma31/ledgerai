# AI Financial Coach — provider configuration
# Copy to .env.local and fill in the key for whichever provider you select.
# AI_PROVIDER selects the active backend: anthropic | openai | gemini | openrouter | ollama
AI_PROVIDER=openrouter

# Anthropic (default)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4.8

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Ollama (local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Connection Hub — OAuth 2.0 credentials for Gmail, Outlook, and Yahoo.
# Tokens are encrypted at rest with this key; generate one with:
#   openssl rand -base64 32
CONNECTION_HUB_ENCRYPTION_KEY=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Add {origin}/api/connections/google/callback as an
# authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Azure Portal -> App registrations -> your app -> Certificates & secrets.
# Add {origin}/api/connections/microsoft/callback as a redirect URI
# (platform: Web).
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Yahoo Developer Network -> My Apps -> your app -> API Permissions.
# Add {origin}/api/connections/yahoo/callback as a redirect URI.
YAHOO_OAUTH_CLIENT_ID=
YAHOO_OAUTH_CLIENT_SECRET=
