enum RecommendationStatus {
  PENDING
  ACCEPTED
  DISMISSED
  EXPIRED
}

// Matches RecommendationPriority in types/recommendation.ts exactly.
enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Matches RecommendationCategory in types/recommendation.ts exactly.
enum RecommendationCategory {
  BUDGET
  SAVINGS
  SUBSCRIPTIONS
  SPENDING
  INCOME
  HABITS
  FORECAST
  GENERAL
}

model Recommendation {
  id               String                   @id @default(cuid())
  organizationId   String
  title            String
  description      String
  reason           String
  action           String
  priority         RecommendationPriority
  category         RecommendationCategory
  status           RecommendationStatus     @default(PENDING)
  relatedObjectIds String[]
  // Reserved for a future LLM-scored recommendation path — the current
  // deterministic rule engine (lib/decision/engine.ts) doesn't produce one.
  confidence       Float?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  searchVector     Unsupported("tsvector")?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("recommendations")
}

model AIConversation {
  id             String   @id @default(cuid())
  organizationId String
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     AIMessage[]

  @@index([organizationId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AIMemoryEntry {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  value          Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("ai_memory_entries")
}

// Search Metadata: no separate IndexedObject table — generated tsvector
// columns + GIN indexes live directly on Transaction/Merchant/Document/
// FeedItem/Recommendation (added via a raw-SQL follow-up migration, since
// Prisma's schema language can't express `GENERATED ALWAYS AS (...) STORED`).

// ============================================================
// Operations
// ============================================================

enum WorkflowStatus {
  ENABLED
  DISABLED
}

model WorkflowDefinition {
  id             String         @id @default(cuid())
  // Deterministic key (e.g. "workflow:budget-exceeded"), unique per
  // organization — NOT the primary key, since the same built-in workflow
  // key is seeded into every organization and a global-uniqueness `id`
  // would let only one organization in the system ever own it.
  key            String
  organizationId String
  name           String
  description    String
  trigger        String
  steps          Json
  status         WorkflowStatus @default(ENABLED)
  priority       Int
  lastRunSummary Json?
  metadata       Json?
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         WorkflowRun[]

  @@unique([organizationId, key])
  @@index([organizationId, trigger])
  @@map("workflow_definitions")
}

enum WorkflowRunStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

model WorkflowRun {
  id              String            @id @default(cuid())
  workflowId      String
  organizationId  String
  trigger         String
  status          WorkflowRunStatus
  startedAt       DateTime
  completedAt     DateTime?
  durationMs      Int?
  successfulSteps Int               @default(0)
  failedSteps     Int               @default(0)
  retryCount      Int               @default(0)
  context         Json?
  inngestEventId  String?           @unique

  workflow     WorkflowDefinition   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        WorkflowStepResult[]

  @@index([organizationId, startedAt])
  @@map("workflow_runs")
}

model WorkflowStepResult {
  id            String    @id @default(cuid())
  workflowRunId String
  engine        String
  action        String
  input         Json?
  output        Json?
  status        String
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  error         String?
  retryCount    Int       @default(0)

  run WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@map("workflow_step_results")
}

model FeedItem {
  id               String                   @id @default(cuid())
  // Deterministic composite key (e.g. "feed:budget:warning:${statusId}"),
  // unique per organization — see WorkflowDefinition.key for why this can't
  // be the global primary key.
  key              String
  organizationId   String
  type             String
  title            String
  summary          String
  priority         Int
  severity         String
  sourceEngine     String
  relatedObjectIds String[]
  explanationId    String?
  confidence       Float
  expiresAt        DateTime?
  isRead           Boolean                  @default(false)
  isPinned         Boolean                  @default(false)
  isDismissed      Boolean                  @default(false)
  metadata         Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  searchVector     Unsupported("tsvector")?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId, isDismissed, priority])
  @@map("feed_items")
}

// Matches POLICY_DECISIONS in types/policy.ts exactly.
enum PolicyDecision {
  NOTIFY_IMMEDIATELY
  SCHEDULE_LATER
  INCLUDE_IN_DAILY_BRIEFING
  INCLUDE_IN_WEEKLY_SUMMARY
  SILENT
  DISMISS
  EXPIRED
}

model NotificationCandidate {
  id                  String         @id @default(cuid())
  organizationId      String
  title               String
  summary             String
  priority            Int
  severity            String
  reason              String
  sourceEngine        String
  relatedObjectIds    String[]
  recommendedChannels String[]
  recommendedTime     DateTime?
  expiresAt           DateTime?
  cooldownKey         String
  confidence          Float
  policyDecision      PolicyDecision
  metadata            Json?
  createdAt           DateTime       @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@index([organizationId, cooldownKey])
  @@map("notification_candidates")
}

enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

model NotificationDelivery {
  id          String              @id @default(cuid())
  candidateId String
  channel     NotificationChannel
  status      DeliveryStatus      @default(PENDING)
  sentAt      DateTime?
  error       String?

  candidate NotificationCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("notification_deliveries")
}

// A single persisted object per organization, not a collection — mirrors
// types/policy.ts's own doc comment on NotificationPreferences ("mirrors
// how Budgets or Coach cache use one record rather than a registry of
// many"). Distinct from UserPreferences (Better Auth-adjacent, user-scoped,
// a different field set entirely) — this is Policy's own domain object.
model NotificationPreferences {
  organizationId         String   @id
  budgetAlerts           Boolean  @default(true)
  forecastAlerts         Boolean  @default(true)
  subscriptionAlerts     Boolean  @default(true)
  achievements           Boolean  @default(true)
  merchantInsights       Boolean  @default(true)
  weeklyDigest           Boolean  @default(true)
  monthlyDigest          Boolean  @default(true)
  quietHoursEnabled      Boolean  @default(false)
  quietHoursStart        String   @default("22:00")
  quietHoursEnd          String   @default("07:00")
  // NotificationChannel values as plain strings, matching
  // NotificationCandidate.recommendedChannels' own choice — the app's
  // NOTIFICATION_CHANNELS union is wider than (and independent of) the
  // NotificationChannel enum above, which only exists for the
  // not-yet-built NotificationDelivery.channel column.
  preferredChannels      String[]
  maxNotificationsPerDay Int      @default(10)
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// lib/policy/cooldown.ts's successor — suppression state keyed by
// cooldownKey (e.g. "budget:Food"), organization-scoped. A Redis TTL-based
// store would fit this shape well too (see the migration plan §3), but
// Postgres keeps this pass consistent with everything else migrated in
// Tier C; revisit alongside the plan's later Redis-wiring phase.
model NotificationCooldown {
  id                   String   @id @default(cuid())
  organizationId       String
  cooldownKey          String
  lastFiredAt          DateTime
  lastContentSignature String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, cooldownKey])
  @@map("notification_cooldowns")
}

enum ScheduleType {
  MORNING_BRIEFING
  EVENING_BRIEFING
  WEEKLY_SUMMARY
  MONTHLY_SUMMARY
}

model BriefingDeliveryLog {
  id             String       @id @default(cuid())
  organizationId String
  scheduleType   ScheduleType
  date           DateTime     @db.Date
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scheduleType, date])
  @@map("briefing_delivery_logs")
}

/** lib/jobs/* — the background job platform's own lifecycle-tracking
 * model. Distinct from SyncJob (a *business* record of "this sync ran")
 * and WorkflowRun (a business record of "this workflow ran"): JobRun
 * tracks the Inngest *execution* underneath any job type, including ones
 * with no other business row of their own (cleanup, health checks). See
 * docs/job-platform/08-worker-architecture.md §8.2. */
enum JobStatus {
  QUEUED
  SCHEDULED
  RUNNING
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
  DEAD_LETTER
}

model JobRun {
  id             String    @id @default(cuid())
  jobType        String
  eventName      String
  inngestEventId String
  inngestRunId   String?
  organizationId String?
  status         JobStatus @default(QUEUED)
  attempt        Int       @default(0)
  progress       Int?
  correlationId  String
  traceId        String?
  input          Json?
  output         Json?
  error          Json?
  queuedAt       DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?
  relatedIds     String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deadLetter   JobDeadLetter?

  // A single Inngest event can fan out to several subscribing functions
  // (e.g. ledger/transaction.classified triggers both workflow-execute and
  // feed-generate) — each gets its own execution and its own JobRun row,
  // so the natural key is (jobType, inngestEventId), not inngestEventId
  // alone. See docs/job-platform/08-worker-architecture.md §8.2.
  @@unique([jobType, inngestEventId])
  @@index([organizationId, createdAt])
  @@index([jobType, status])
  @@index([status, startedAt])
  @@index([correlationId])
  @@map("job_runs")
}

model JobDeadLetter {
  id             String    @id @default(cuid())
  jobRunId       String    @unique
  jobType        String
  organizationId String?
  eventPayload   Json
  error          Json
  originalRunId  String
  resolvedAt     DateTime?
  resolvedBy     String?
  retryOfId      String?
  createdAt      DateTime  @default(now())

  jobRun       JobRun        @relation(fields: [jobRunId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, resolvedAt])
  @@index([jobType])
  @@map("job_dead_letters")
}
